generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model appointments {
  appointment_id   Int           @id @default(autoincrement())
  pet_id           Int
  vet_id           Int
  appointment_date DateTime      @db.Date
  appointment_time DateTime      @db.Time(6)
  symptoms         String?
  status           String?       @default("Scheduled") @db.VarChar(20)
  pets             pets          @relation(fields: [pet_id], references: [pet_id], onDelete: NoAction, onUpdate: NoAction)
  veterinarians    veterinarians @relation(fields: [vet_id], references: [vet_id], onDelete: NoAction, onUpdate: NoAction)
  visits           visits?
}

model bills {
  bill_id        Int        @id @default(autoincrement())
  treatment_id   Int        @unique
  service_fee    Decimal?   @default(0) @db.Decimal(10, 2)
  medicine_fee   Decimal?   @default(0) @db.Decimal(10, 2)
  total_amount   Decimal    @db.Decimal(10, 2)
  payment_status String?    @default("Unpaid") @db.VarChar(20)
  payment_date   DateTime?  @db.Date
  treatments     treatments @relation(fields: [treatment_id], references: [treatment_id], onDelete: NoAction, onUpdate: NoAction)
}

model medicines {
  medicine_id        Int                  @id @default(autoincrement())
  medicine_name      String               @db.VarChar(150)
  unit               String?              @db.VarChar(50)
  price              Decimal              @db.Decimal(10, 2)
  stock_quantity     Int?                 @default(0)
  prescription_items prescription_items[]
}

model owners {
  owner_id   Int     @id @default(autoincrement())
  first_name String  @db.VarChar(100)
  last_name  String  @db.VarChar(100)
  phone      String  @db.VarChar(20)
  email      String? @db.VarChar(150)
  address    String?
  pets       pets[]
}

model pets {
  pet_id       Int            @id @default(autoincrement())
  owner_id     Int
  pet_name     String         @db.VarChar(100)
  species      String         @db.VarChar(50)
  breed        String?        @db.VarChar(100)
  gender       String?        @db.VarChar(10)
  birth_date   DateTime?      @db.Date
  weight       Decimal?       @db.Decimal(5, 2)
  color        String?        @db.VarChar(50)
  allergy_info String?
  appointments appointments[]
  owners       owners         @relation(fields: [owner_id], references: [owner_id], onDelete: NoAction, onUpdate: NoAction)
  visits       visits[]
}

model prescription_items {
  prescription_id Int
  medicine_id     Int
  quantity        Int
  dosage          String?       @db.VarChar(100)
  instruction     String?
  medicines       medicines     @relation(fields: [medicine_id], references: [medicine_id], onDelete: NoAction, onUpdate: NoAction)
  prescriptions   prescriptions @relation(fields: [prescription_id], references: [prescription_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([prescription_id, medicine_id])
}

model prescriptions {
  prescription_id    Int                  @id @default(autoincrement())
  treatment_id       Int                  @unique
  prescription_date  DateTime             @db.Date
  prescription_items prescription_items[]
  treatments         treatments           @relation(fields: [treatment_id], references: [treatment_id], onDelete: NoAction, onUpdate: NoAction)
}

model treatments {
  treatment_id     Int            @id @default(autoincrement())
  diagnosis        String
  treatment_detail String?
  treatment_date   DateTime       @db.Date
  visit_id         Int            @unique(map: "treatments_visit_id_unique")
  bills            bills?
  prescriptions    prescriptions?
  visits           visits         @relation(fields: [visit_id], references: [visit_id], onDelete: NoAction, onUpdate: NoAction)
}

model veterinarians {
  vet_id         Int            @id @default(autoincrement())
  license_number String         @unique @db.VarChar(50)
  first_name     String         @db.VarChar(100)
  last_name      String         @db.VarChar(100)
  specialization String?        @db.VarChar(100)
  phone          String?        @db.VarChar(20)
  appointments   appointments[]
  visits         visits[]
}

model visits {
  visit_id       Int           @id @default(autoincrement())
  pet_id         Int
  vet_id         Int
  appointment_id Int?          @unique
  visit_at       DateTime      @default(now()) @db.Timestamp(6)
  treatments     treatments?
  appointments   appointments? @relation(fields: [appointment_id], references: [appointment_id], onDelete: NoAction, onUpdate: NoAction)
  pets           pets          @relation(fields: [pet_id], references: [pet_id], onDelete: NoAction, onUpdate: NoAction)
  veterinarians  veterinarians @relation(fields: [vet_id], references: [vet_id], onDelete: NoAction, onUpdate: NoAction)
}
